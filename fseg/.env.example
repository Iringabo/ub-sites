CI_ENVIRONMENT = development

# --------------------------------------------------------------------
# APP
# --------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.defaultLocale = fr
app.appTimezone = Africa/Bujumbura
app.forceGlobalSecureRequests = false
app.CSPEnabled = true

# --------------------------------------------------------------------
# RÔLE DE CETTE INSTANCE (modèle multi-dossiers)
# Voir docs/TEMPLATE_SETUP.md pour la procédure complète de copie.
# --------------------------------------------------------------------
#
# Ce dossier est un MODÈLE : copiez-le pour créer chaque instance réelle,
# puis configurez UNIQUEMENT les clés ci-dessous dans le .env de la copie.
#
# --- INSTANCE FACULTAIRE (site public + /admin de cette faculté) ---
#
#   app.siteSlug         = fseg
#   app.centralAdminMode = false
#
# --- INSTANCE SUPERADMINISTRATION (connexion + pilotage de tous les sites) ---
#
#   app.siteSlug         = (laisser vide ou identique à la faculté par défaut)
#   app.centralAdminMode = true
#
# Le site servi par une instance facultaire est résolu ainsi :
# hôte de la requête listé dans les domaines du site → app.siteId →
# app.siteSlug. En multi-dossiers, app.siteSlug suffit.

app.siteSlug =
app.centralAdminMode = false

# Slug du site « par défaut » (faculté servie en repli, page d'accueil de
# l'instance superadmin). Laisser vide sur une installation neuve : le
# premier site créé via `php spark site:create` devient le site par défaut.
app.defaultSiteSlug =

# Domaines locaux autorisés à générer des URLs avec l'hôte courant.
app.allowedHostnames =
# Si true, les pages publiques répondent 404 lorsque l'hôte n'est listé
# dans les domaines d'aucun site actif (recommandé en production).
app.requireKnownHostname = false

# --------------------------------------------------------------------
# DATABASE — IDENTIQUE DANS TOUTES LES INSTANCES (base unique partagée)
# Les migrations ne se lancent qu'une seule fois, depuis n'importe
# quelle instance : php spark migrate --all
# --------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = plateforme
database.default.username = plateforme_user
database.default.password = your-database-password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.DBDebug = true

# ATTENTION : la suite PHPUnit supprime et recrée cette base.
# Utiliser une base dédiée, jamais la base de développement ou production.
database.tests.hostname = localhost
database.tests.database = platform_test
database.tests.username = platform_test_user
database.tests.password = your-test-database-password
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = test_
database.tests.port = 3306

# --------------------------------------------------------------------
# EMAIL NOTIFICATION DU CONTACT (instance facultaire concernée)
# --------------------------------------------------------------------

CONTACT_NOTIFICATION_ENABLED = false
CONTACT_NOTIFICATION_RECIPIENT = contact@example.test
CONTACT_NOTIFICATION_FROM_EMAIL = no-reply@example.test
CONTACT_NOTIFICATION_FROM_NAME = Plateforme
CONTACT_NOTIFICATION_PROTOCOL = smtp
CONTACT_NOTIFICATION_SMTP_HOST = smtp.example.test
CONTACT_NOTIFICATION_SMTP_PORT = 587
CONTACT_NOTIFICATION_SMTP_CRYPTO = tls
CONTACT_NOTIFICATION_SMTP_USER = smtp-user
CONTACT_NOTIFICATION_SMTP_PASS = smtp-password

# --------------------------------------------------------------------
# SÉCURITÉ
# --------------------------------------------------------------------

encryption.key =

# Avant la mise en production de chaque instance :
#   php spark key:generate
#   php spark app:production-check
# En production, database.default.DBDebug doit valoir false.
