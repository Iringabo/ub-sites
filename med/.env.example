CI_ENVIRONMENT = development

# --------------------------------------------------------------------
# APP — instance MED
# --------------------------------------------------------------------

app.baseURL = 'http://localhost:8104/'
app.defaultLocale = fr
app.appTimezone = Africa/Bujumbura
app.forceGlobalSecureRequests = false
app.CSPEnabled = true

app.siteSlug = med
app.centralAdminMode = false
app.defaultSiteSlug =
app.allowedHostnames =
app.requireKnownHostname = false

# --------------------------------------------------------------------
# DATABASE — IDENTIQUE DANS TOUTES LES INSTANCES (base unique partagée)
# --------------------------------------------------------------------

# Le nom réel doit être identique dans toutes les instances (base unique partagée).
database.default.hostname = localhost
database.default.database = ub_shared
database.default.username = plateforme_user
database.default.password = your-database-password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.DBDebug = true

# ATTENTION : la suite PHPUnit supprime et recrée cette base.
database.tests.hostname = localhost
database.tests.database = platform_test
database.tests.username = platform_test_user
database.tests.password = your-test-database-password
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = test_
database.tests.port = 3306

# --------------------------------------------------------------------
# EMAIL
# --------------------------------------------------------------------

CONTACT_NOTIFICATION_ENABLED = false
CONTACT_NOTIFICATION_RECIPIENT = contact@example.test
CONTACT_NOTIFICATION_FROM_EMAIL = no-reply@example.test
CONTACT_NOTIFICATION_FROM_NAME = Plateforme
CONTACT_NOTIFICATION_PROTOCOL = smtp
CONTACT_NOTIFICATION_SMTP_HOST = smtp.example.test
CONTACT_NOTIFICATION_SMTP_PORT = 587
CONTACT_NOTIFICATION_SMTP_CRYPTO = tls
CONTACT_NOTIFICATION_SMTP_USER = smtp-user
CONTACT_NOTIFICATION_SMTP_PASS = smtp-password

# --------------------------------------------------------------------
# SÉCURITÉ
# --------------------------------------------------------------------

encryption.key =

session.cookieName = ci_session_med
session.rememberCookieName = remember_med

# Copie des téléversements vers le dossier public de chaque faculté
# (surtout pour l’instance superadmin). Dossier d’instance ou .../public.
# app.uploadMirrors = fseg:/absolute/path/fseg,fsi:/absolute/path/fsi
# app.previewBase.med = http://localhost:8104/

# IPs du reverse proxy, de confiance pour X-Forwarded-For et X-Forwarded-Host.
# Liste séparée par des virgules, ou JSON {"10.0.0.1":"X-Forwarded-For"}.
# Laisser vide si PHP n’est pas derrière un proxy.
# app.proxyIPs = 10.0.0.1,10.0.0.2

# php spark key:generate
# php spark app:production-check
