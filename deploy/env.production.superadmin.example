# Production environment — superadmin instance

Copy to `superadmin/.env` on the server.  
Replace every `CHANGE_ME` value. Database credentials must match every faculty `.env`.

```ini
CI_ENVIRONMENT = production

app.baseURL = 'https://admin.CHANGE_ME.edu/'
app.defaultLocale = fr
app.appTimezone = Africa/Bujumbura
app.forceGlobalSecureRequests = true
app.CSPEnabled = true

app.siteSlug =
app.centralAdminMode = true
app.defaultSiteSlug = fseg
app.allowedHostnames = admin.CHANGE_ME.edu
app.requireKnownHostname = true

# Same pattern as the faculty .env files. site:create reads it from
# whichever folder you run the command in.
app.publicHostPattern = {slug}.CHANGE_ME.edu

database.default.hostname = localhost
database.default.database = ub_shared
database.default.username = ubapp
database.default.password = CHANGE_ME_STRONG_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.DBDebug = false

database.tests.hostname = localhost
database.tests.database = ub_shared_test_UNUSED
database.tests.username = ubapp
database.tests.password = CHANGE_ME_STRONG_DB_PASSWORD
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = test_
database.tests.port = 3306

CONTACT_NOTIFICATION_ENABLED = false

encryption.key = CHANGE_ME_RUN_php_spark_key_generate

session.cookieName = ci_session_central
session.rememberCookieName = remember_central

# Absolute paths to each faculty instance (folder or .../public). Required so
# uploads / demo seed mirror into the right public trees.
app.uploadMirrors = fseg:/var/www/fseg,fsi:/var/www/fsi,med:/var/www/med,fabi:/var/www/fabi,flsh:/var/www/flsh

# Public preview URLs shown from central admin (HTTPS).
app.previewBase.fseg = https://fseg.CHANGE_ME.edu/
app.previewBase.fsi = https://fsi.CHANGE_ME.edu/
app.previewBase.med = https://med.CHANGE_ME.edu/
app.previewBase.fabi = https://fabi.CHANGE_ME.edu/
app.previewBase.flsh = https://flsh.CHANGE_ME.edu/

# app.proxyIPs = 10.0.0.1
```

## After writing `.env`

```bash
cd /var/www/superadmin
php spark key:generate
php spark app:production-check
php spark app:production-check --strict
```

Public URLs on this instance must redirect to `/admin` (central mode).  
See [09-production-go-live.md](09-production-go-live.md).
